{
  "name": "enrich",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@enrich/web --filter=@enrich/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @enrich/db db:generate",
    "db:migrate": "pnpm --filter @enrich/db db:migrate",
    "db:studio": "pnpm --filter @enrich/db db:studio",
    "db:seed": "pnpm --filter @enrich/db db:seed",
    "sample:happierleads": "pnpm --filter @enrich/db sample:happierleads"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
